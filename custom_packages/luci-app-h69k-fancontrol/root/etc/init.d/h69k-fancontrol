#!/bin/sh /etc/rc.common

START=15
STOP=90
USE_PROCD=1

PROG=/usr/sbin/h69k-fancontrol

start_service() {
	config_load h69k-fancontrol
	config_get_bool enabled main enabled 1

	if [ "$enabled" -ne 1 ]; then
		"$PROG" full >/dev/null 2>&1
		return 0
	fi

	procd_open_instance
	procd_set_param command "$PROG" daemon
	procd_set_param respawn 5 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# A stopped controller must fail safe instead of leaving the fan off.
	"$PROG" full >/dev/null 2>&1
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger h69k-fancontrol
}
